# ============================================================
# Variables de entorno del servidor (copiar a .env y completar).
# .env NUNCA se versiona (está en .gitignore). Aquí solo hay nombres
# y marcadores: no escriba valores reales en este archivo.
# ============================================================

# Puerto HTTP dentro del contenedor (el contenedor publica 8080)
PORT=8080

# Clave para cifrar con AES-256-GCM los datos y los usuarios en disco (obligatoria)
DATA_KEY=<frase-larga-y-aleatoria>

# Primer coordinador (solo se usa si todavía no existe ningún usuario)
ADMIN_USER=coordinacion
ADMIN_PASS=<contraseña-inicial-de-al-menos-8-caracteres>

# 1 cuando la plataforma se sirve detrás de HTTPS (marca la cookie como Secure)
COOKIE_SECURE=

# Duración de la sesión en horas
SESSION_HOURS=12
